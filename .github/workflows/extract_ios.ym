name: Extract iOS Firmware Components

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

env:
  DEVICE: "iPhone11,2"
  VERSION: "18.7.6"
  BUILD: "22H320"
  FIRMWARE_URL: "https://updates.cdn-apple.com/2026WinterFCS/fullrestores/047-83292/FC308431-84C0-4001-9A24-09FC77486C76/iPhone11,2,iPhone11,4,iPhone11,6_18.7.6_22H320_Restore.ipsw"

jobs:
  extract:
    runs-on: macos-latest
    timeout-minutes: 120
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Create output directories
        run: |
          mkdir -p ios_extracted/{daemons,frameworks,dyld_cache,symbols}
          echo "输出目录创建完成"
      
      - name: Install ipsw
        run: |
          echo "安装 ipsw..."
          brew tap blacktop/tap
          brew install ipsw
          ipsw version
          echo "✅ ipsw 安装完成"
      
      - name: Download firmware with direct URL
        run: |
          echo "使用直接链接下载固件..."
          echo "URL: $FIRMWARE_URL"
          
          curl -L -C - -o firmware.ipsw \
            --retry 5 \
            --retry-delay 10 \
            --connect-timeout 30 \
            --max-time 3600 \
            "$FIRMWARE_URL"
          
          if [ -f "firmware.ipsw" ]; then
            SIZE=$(ls -lh firmware.ipsw | awk '{print $5}')
            echo "✅ 固件下载成功! 大小: $SIZE"
          else
            echo "❌ 固件下载失败"
            exit 1
          fi
      
      - name: Extract dyld cache
        run: |
          echo "解压 IPSW..."
          unzip -q firmware.ipsw -d firmware/
          
          SYSTEM_DMG=$(find firmware -name "*.dmg" | head -1)
          echo "系统 DMG: $SYSTEM_DMG"
          
          hdiutil attach "$SYSTEM_DMG" -mountpoint /Volumes/System -nobrowse
          
          echo "全目录查找 dyld 缓存..."
          DYLD_PATH=$(sudo find /Volumes/System -name "dyld_shared_cache*" -type f 2>/dev/null | head -1)
          
          if [ -n "$DYLD_PATH" ]; then
            cp "$DYLD_PATH" ios_extracted/dyld_cache/
            SIZE=$(ls -lh ios_extracted/dyld_cache/$(basename "$DYLD_PATH") | awk '{print $5}')
            echo "✅ dyld 缓存 ($SIZE) - 路径: $DYLD_PATH"
          else
            echo "⚠️ 未找到 dyld 缓存"
          fi
          
          hdiutil detach /Volumes/System || true
        continue-on-error: true
      
      - name: Extract daemons
        run: |
          SYSTEM_DMG=$(find firmware -name "*.dmg" | head -1)
          hdiutil attach "$SYSTEM_DMG" -mountpoint /Volumes/System -nobrowse
          
          echo "全目录查找守护进程..."
          
          for daemon in amfid installd sandboxd trustd; do
            FOUND=$(sudo find /Volumes/System -name "$daemon" -type f 2>/dev/null | head -1)
            
            if [ -n "$FOUND" ]; then
              cp "$FOUND" ios_extracted/daemons/
              SIZE=$(ls -lh ios_extracted/daemons/$daemon | awk '{print $5}')
              echo "✅ $daemon ($SIZE) - 路径: $FOUND"
            else
              echo "⚠️ 未找到 $daemon"
            fi
          done
          
          hdiutil detach /Volumes/System || true
          
          echo ""
          echo "提取的守护进程:"
          ls -la ios_extracted/daemons/
        continue-on-error: true
      
      - name: Extract frameworks
        run: |
          SYSTEM_DMG=$(find firmware -name "*.dmg" | head -1)
          hdiutil attach "$SYSTEM_DMG" -mountpoint /Volumes/System -nobrowse
          
          echo "全目录查找框架..."
          
          # AMFI 框架
          AMFI_PATH=$(sudo find /Volumes/System -type d -name "AppleMobileFileIntegrity.framework" 2>/dev/null | head -1)
          if [ -n "$AMFI_PATH" ]; then
            cp -R "$AMFI_PATH" ios_extracted/frameworks/
            echo "✅ AMFI 框架 - 路径: $AMFI_PATH"
          else
            echo "⚠️ 未找到 AMFI 框架"
          fi
          
          # Security 框架
          SECURITY_PATH=$(sudo find /Volumes/System -type d -name "Security.framework" 2>/dev/null | head -1)
          if [ -n "$SECURITY_PATH" ]; then
            cp -R "$SECURITY_PATH" ios_extracted/frameworks/
            echo "✅ Security 框架 - 路径: $SECURITY_PATH"
          else
            echo "⚠️ 未找到 Security 框架"
          fi
          
          hdiutil detach /Volumes/System || true
          
          echo ""
          echo "提取的框架:"
          ls -la ios_extracted/frameworks/
        continue-on-error: true
      
      - name: Extract strings and symbols
        run: |
          echo "提取字符串和符号..."
          
          for daemon in amfid installd sandboxd trustd; do
            if [ -f "ios_extracted/daemons/$daemon" ]; then
              strings ios_extracted/daemons/$daemon > ios_extracted/symbols/${daemon}_all_strings.txt 2>/dev/null
              strings ios_extracted/daemons/$daemon | grep -E "com.apple|XPC|entitlement|AMFI|sandbox|version|error|fail" > ios_extracted/symbols/${daemon}_key_strings.txt 2>/dev/null
              COUNT=$(wc -l < ios_extracted/symbols/${daemon}_key_strings.txt 2>/dev/null || echo "0")
              echo "✅ $daemon: $COUNT 关键字符串"
            fi
          done
          
          DYLD=$(find ios_extracted/dyld_cache -name "dyld_shared_cache*" -type f | head -1)
          if [ -n "$DYLD" ]; then
            echo "从 dyld 缓存提取关键字符串..."
            strings "$DYLD" | grep -E "amfid|installd|sandboxd|trustd|AMFI|Security|com.apple" > ios_extracted/symbols/dyld_key_strings.txt 2>/dev/null || true
            COUNT=$(wc -l < ios_extracted/symbols/dyld_key_strings.txt 2>/dev/null || echo "0")
            echo "✅ dyld: $COUNT 关键字符串"
          fi
      
      - name: Generate extraction report
        run: |
          cat > ios_extracted/README.md << 'EOF'
          # iOS 固件提取报告
          
          ## 提取信息
          
          EOF
          
          echo "- **设备**: $DEVICE" >> ios_extracted/README.md
          echo "- **iOS 版本**: $VERSION ($BUILD)" >> ios_extracted/README.md
          echo "- **提取时间**: $(date -u '+%Y-%m-%d %H:%M:%S UTC')" >> ios_extracted/README.md
          echo "- **运行 ID**: ${{ github.run_id }}" >> ios_extracted/README.md
          
          echo "" >> ios_extracted/README.md
          echo "## 提取的文件" >> ios_extracted/README.md
          echo "" >> ios_extracted/README.md
          
          echo "### 守护进程" >> ios_extracted/README.md
          for f in ios_extracted/daemons/*; do
            if [ -f "$f" ]; then
              size=$(ls -lh "$f" | awk '{print $5}')
              name=$(basename "$f")
              file_type=$(file "$f" | cut -d: -f2 | cut -c1-50)
              echo "- **$name** ($size) - $file_type" >> ios_extracted/README.md
            fi
          done
          
          echo "" >> ios_extracted/README.md
          echo "### 框架" >> ios_extracted/README.md
          for f in ios_extracted/frameworks/*; do
            if [ -d "$f" ]; then
              size=$(du -sh "$f" | cut -f1)
              name=$(basename "$f")
              echo "- **$name** ($size)" >> ios_extracted/README.md
            fi
          done
          
          echo "" >> ios_extracted/README.md
          echo "### dyld 缓存" >> ios_extracted/README.md
          for f in ios_extracted/dyld_cache/*; do
            if [ -f "$f" ]; then
              size=$(ls -lh "$f" | awk '{print $5}')
              name=$(basename "$f")
              echo "- **$name** ($size)" >> ios_extracted/README.md
            fi
          done
          
          echo "" >> ios_extracted/README.md
          echo "## 字符串统计" >> ios_extracted/README.md
          echo "" >> ios_extracted/README.md
          echo "| 文件 | 关键字符串数 |" >> ios_extracted/README.md
          echo "|------|-------------|" >> ios_extracted/README.md
          
          for f in ios_extracted/symbols/*_key_strings.txt; do
            if [ -f "$f" ]; then
              count=$(wc -l < "$f")
              name=$(basename "$f" | sed 's/_key_strings.txt//')
              echo "| $name | $count |" >> ios_extracted/README.md
            fi
          done
          
          echo "" >> ios_extracted/README.md
          echo "## 使用说明" >> ios_extracted/README.md
          echo '```bash' >> ios_extracted/README.md
          echo "# 解压查看" >> ios_extracted/README.md
          echo "tar -xzf ios_extracted_${DEVICE}_${VERSION}.tar.gz" >> ios_extracted/README.md
          echo "cd ios_extracted" >> ios_extracted/README.md
          echo "" >> ios_extracted/README.md
          echo "# 查看守护进程字符串" >> ios_extracted/README.md
          echo "cat symbols/amfid_key_strings.txt | head -50" >> ios_extracted/README.md
          echo '```' >> ios_extracted/README.md
          
          echo "报告生成完成"
          cat ios_extracted/README.md
      
      - name: Package results
        run: |
          echo "打包提取的文件..."
          tar -czf ios_extracted_${DEVICE}_${VERSION}_${BUILD}.tar.gz ios_extracted/
          PACKAGE_SIZE=$(ls -lh ios_extracted_*.tar.gz | awk '{print $5}')
          echo "✅ 打包完成: $PACKAGE_SIZE"
      
      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: ios_extracted_${{ env.DEVICE }}_${{ env.VERSION }}
          path: ios_extracted_*.tar.gz
          retention-days: 7
          compression-level: 6
      
      - name: Commit report to repository
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          
          git add ios_extracted/README.md ios_extracted/symbols/*_key_strings.txt 2>/dev/null || true
          
          if git diff --staged --quiet; then
            echo "没有新文件需要提交"
          else
            git commit -m "🤖 自动提取 iOS $VERSION ($BUILD) 固件组件 [skip ci]"
            git push
            echo "✅ 已推送到仓库"
          fi
        continue-on-error: true
      
      - name: Completion
        run: |
          echo ""
          echo "========================================="
          echo "✅ 提取完成！"
          echo "========================================="
          echo ""
          echo "📊 提取结果:"
          echo "   守护进程: $(ls -1 ios_extracted/daemons/ 2>/dev/null | wc -l) 个"
          echo "   框架: $(ls -1 ios_extracted/frameworks/ 2>/dev/null | wc -l) 个"
          echo "   关键字符串: $(find ios_extracted/symbols -name '*_key_strings.txt' -exec wc -l {} \; 2>/dev/null | awk '{sum+=$1} END {print sum}') 行"
          echo ""
          echo "📦 下载方式:"
          echo "   1. Actions → 点击运行 → Artifacts"
          echo "   2. 下载: ios_extracted_${DEVICE}_${VERSION}_${BUILD}.tar.gz"
          echo ""
          echo "📁 或在仓库中查看:"
          echo "   ios_extracted/README.md"
          echo "   ios_extracted/symbols/*_key_strings.txt"
