name: 分析 valid.sqlite3 和 Tips.app

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  analyze:
    runs-on: macos-latest
    timeout-minutes: 60

    steps:
      - name: 检出仓库
        uses: actions/checkout@v4

      - name: 安装工具
        run: |
          brew install sqlite
          brew tap blacktop/tap && brew install ipsw

      - name: 创建输出目录
        run: mkdir -p output/{sqlite,tips_txt,tips_app}

      - name: 分析 valid.sqlite3
        run: |
          if [ -f valid.sqlite3 ]; then
            echo "=== 表列表 ===" > output/sqlite/tables.txt
            sqlite3 valid.sqlite3 ".tables" >> output/sqlite/tables.txt 2>&1
            echo "=== 完整结构 ===" > output/sqlite/schema.txt
            sqlite3 valid.sqlite3 ".schema" >> output/sqlite/schema.txt 2>&1
            for TABLE in $(sqlite3 valid.sqlite3 ".tables" 2>/dev/null); do
              echo "=== $TABLE ===" >> output/sqlite/all_data.txt
              sqlite3 valid.sqlite3 "PRAGMA table_info($TABLE);" >> output/sqlite/all_data.txt 2>&1
              sqlite3 valid.sqlite3 "SELECT * FROM $TABLE;" 2>/dev/null | xxd | head -200 >> output/sqlite/all_data.txt
            done
            sqlite3 valid.sqlite3 ".tables" 2>/dev/null | grep -qi "code" && sqlite3 valid.sqlite3 "SELECT hex(cdhash) FROM code LIMIT 50;" 2>/dev/null > output/sqlite/cdhash.txt || true
            sqlite3 valid.sqlite3 ".tables" 2>/dev/null | grep -qi "team" && sqlite3 valid.sqlite3 "SELECT * FROM team;" 2>/dev/null | strings | head -100 > output/sqlite/team.txt || true
          fi

      - name: 分析 com.apple.tips.txt
        run: |
          if [ -f "com.apple.tips.txt" ]; then
            strings "com.apple.tips.txt" | grep -iE "TeamIdentifier|Authority|Identifier" > output/tips_txt/teamid.txt || true
            strings "com.apple.tips.txt" | grep -E "OID|1.2.840|1.3.6.1" | head -100 > output/tips_txt/oid.txt || true
            strings "com.apple.tips.txt" | grep -iE "Subject|Issuer|OU=|CN=" | head -100 > output/tips_txt/cert.txt || true
          fi

      - name: 下载 IPSW 并提取 Tips.app
        run: |
          curl -L -o firmware.ipsw "https://updates.cdn-apple.com/2026WinterFCS/fullrestores/047-83292/FC308431-84C0-4001-9A24-09FC77486C76/iPhone11,2,iPhone11,4,iPhone11,6_18.7.6_22H320_Restore.ipsw"
          
          echo "=== 从 System/Library/Applications 提取 Tips.app ==="
          ipsw extract --files --pattern 'Applications/Tips.app/' -o output/tips_app firmware.ipsw 2>&1 || true
          
          echo "=== 提取结果 ==="
          find output/tips_app -type d 2>/dev/null
          find output/tips_app -type f -name "Tips" 2>/dev/null

      - name: 分析固件中的 Tips.app
        run: |
          APP_DIR=$(find output/tips_app -name "Tips.app" -type d 2>/dev/null | head -1)
          
          if [ -n "$APP_DIR" ] && [ -d "$APP_DIR" ]; then
            echo "=== 找到 Tips.app: $APP_DIR ==="
            
            codesign -dvvv "$APP_DIR" > output/tips_app/signature.txt 2>&1 || true
            
            codesign -dv "$APP_DIR" 2>&1 | grep -iE "TeamIdentifier|Authority|Identifier" > output/tips_app/teamid.txt || true
            
            codesign -d --entitlements - "$APP_DIR" > output/tips_app/entitlements.txt 2>&1 || true
            
            EXECUTABLE=$(find "$APP_DIR" -type f -name "Tips" 2>/dev/null | head -1)
            if [ -n "$EXECUTABLE" ]; then
              security cms -D -i "$EXECUTABLE" > output/tips_app/cms.txt 2>&1 || true
              grep -E "OID|1.2.840|1.3.6.1" output/tips_app/cms.txt 2>/dev/null | head -100 > output/tips_app/oid.txt || true
              grep -iE "Subject|Issuer|OU=" output/tips_app/cms.txt 2>/dev/null | head -50 > output/tips_app/cert.txt || true
            fi
            
            cat output/tips_app/teamid.txt
            echo "---"
            cat output/tips_app/oid.txt | head -30
          else
            echo "未找到 Tips.app"
          fi

      - name: 上传分析结果
        uses: actions/upload-artifact@v4
        with:
          name: full_analysis
          path: output/
          retention-days: 90
