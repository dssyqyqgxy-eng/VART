name: Extract iOS Firmware

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  extract:
    runs-on: macos-latest
    timeout-minutes: 120

    steps:
      - name: Create output directories
        run: |
          mkdir -p ios_extracted/daemons
          mkdir -p ios_extracted/frameworks
          mkdir -p ios_extracted/dyld_cache

      - name: Install ipsw
        run: |
          brew tap blacktop/tap
          brew install ipsw
          ipsw version

      - name: Download firmware
        run: |
          curl -L -o firmware.ipsw "https://updates.cdn-apple.com/2026WinterFCS/fullrestores/047-83292/FC308431-84C0-4001-9A24-09FC77486C76/iPhone11,2,iPhone11,4,iPhone11,6_18.7.6_22H320_Restore.ipsw"
          ls -lh firmware.ipsw

      - name: Extract dyld cache with ipsw
        run: |
          # 正确的命令格式
          ipsw extract --dyld --dyld-arch arm64e firmware.ipsw -o ios_extracted/dyld_cache/ || echo "提取失败"
          ls -la ios_extracted/dyld_cache/

      - name: Extract dyld cache from remote (alternative)
        if: failure()
        run: |
          ipsw extract --dyld --remote --dyld-arch arm64e "$FIRMWARE_URL" -o ios_extracted/dyld_cache/ || echo "远程提取失败"

      - name: Mount DMG manually if needed
        if: always()
        run: |
          echo "解压 IPSW..."
          unzip -q firmware.ipsw -d firmware/ || echo "解压失败"
          
          echo "查找系统 DMG..."
          SYSTEM_DMG=$(find firmware -name "*.dmg" | head -1)
          echo "找到: $SYSTEM_DMG"
          
          if [ -f "$SYSTEM_DMG" ]; then
            echo "尝试挂载..."
            sudo hdiutil attach "$SYSTEM_DMG" -mountpoint /Volumes/System -nobrowse -readonly || echo "挂载失败"
            ls -la /Volumes/System/ || echo "无法列出"
          fi

      - name: Search mounted volume
        if: always()
        run: |
          if [ -d "/Volumes/System" ]; then
            echo "搜索 /Volumes/System..."
            
            for daemon in amfid installd sandboxd trustd; do
              FOUND=$(sudo find /Volumes/System -name "$daemon" -type f 2>/dev/null | head -1)
              if [ -n "$FOUND" ]; then
                echo "找到 $daemon: $FOUND"
                sudo cp "$FOUND" ios_extracted/daemons/ 2>/dev/null || true
              fi
            done
            
            DYLD=$(sudo find /Volumes/System -name "dyld_shared_cache*" -type f 2>/dev/null | head -1)
            if [ -n "$DYLD" ]; then
              echo "找到 dyld: $DYLD"
              sudo cp "$DYLD" ios_extracted/dyld_cache/ 2>/dev/null || true
            fi
            
            AMFI=$(sudo find /Volumes/System -type d -name "AppleMobileFileIntegrity.framework" 2>/dev/null | head -1)
            if [ -n "$AMFI" ]; then
              echo "找到 AMFI: $AMFI"
              sudo cp -R "$AMFI" ios_extracted/frameworks/ 2>/dev/null || true
            fi
            
            SECURITY=$(sudo find /Volumes/System -type d -name "Security.framework" 2>/dev/null | head -1)
            if [ -n "$SECURITY" ]; then
              echo "找到 Security: $SECURITY"
              sudo cp -R "$SECURITY" ios_extracted/frameworks/ 2>/dev/null || true
            fi
            
            sudo hdiutil detach /Volumes/System -force 2>/dev/null || true
          else
            echo "/Volumes/System 不存在"
          fi

      - name: Extract strings from IPSW (final resort)
        if: always()
        run: |
          echo "从 IPSW 提取字符串..."
          strings firmware.ipsw | grep -E "amfid|installd|sandboxd|trustd|AMFI|Security|com.apple.amfi|com.apple.sandboxd" > ios_extracted/ipsw_strings.txt || true
          echo "提取了 $(wc -l < ios_extracted/ipsw_strings.txt) 行字符串"

      - name: Fix permissions
        run: |
          sudo chown -R $(whoami) ios_extracted/ 2>/dev/null || true

      - name: Upload results
        uses: actions/upload-artifact@v4
        with:
          name: ios_extracted
          path: ios_extracted/
          retention-days: 7
