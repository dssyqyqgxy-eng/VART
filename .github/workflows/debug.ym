name: Search Mounted Volumes

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  search:
    runs-on: macos-latest
    timeout-minutes: 30

    steps:
      - name: Create output directories
        run: |
          mkdir -p ios_extracted/daemons
          mkdir -p ios_extracted/frameworks
          mkdir -p ios_extracted/dyld_cache
          echo "目录创建完成"

      - name: Search all mounted volumes
        run: |
          echo "=== 列出所有已挂载卷 ==="
          ls -la /Volumes/
          
          echo ""
          echo "=== 搜索所有卷中的守护进程 ==="
          
          for VOLUME in /Volumes/*; do
            if [ -d "$VOLUME" ]; then
              echo ""
              echo "搜索卷: $VOLUME"
              
              for daemon in amfid installd sandboxd trustd; do
                FOUND=$(sudo find "$VOLUME" -name "$daemon" -type f 2>/dev/null | head -1)
                if [ -n "$FOUND" ]; then
                  echo "找到 $daemon: $FOUND"
                  sudo cp "$FOUND" ios_extracted/daemons/
                fi
              done
              
              DYLD=$(sudo find "$VOLUME" -name "dyld_shared_cache*" -type f 2>/dev/null | head -1)
              if [ -n "$DYLD" ]; then
                echo "找到 dyld: $DYLD"
                sudo cp "$DYLD" ios_extracted/dyld_cache/
              fi
              
              AMFI=$(sudo find "$VOLUME" -type d -name "AppleMobileFileIntegrity.framework" 2>/dev/null | head -1)
              if [ -n "$AMFI" ]; then
                echo "找到 AMFI: $AMFI"
                sudo cp -R "$AMFI" ios_extracted/frameworks/
              fi
              
              SECURITY=$(sudo find "$VOLUME" -type d -name "Security.framework" 2>/dev/null | head -1)
              if [ -n "$SECURITY" ]; then
                echo "找到 Security: $SECURITY"
                sudo cp -R "$SECURITY" ios_extracted/frameworks/
              fi
            fi
          done
          
          sudo chown -R $(whoami) ios_extracted/
          
          echo ""
          echo "=== 搜索结果 ==="
          echo "守护进程:"
          ls -la ios_extracted/daemons/ 2>/dev/null || echo "无"
          echo ""
          echo "框架:"
          ls -la ios_extracted/frameworks/ 2>/dev/null || echo "无"
          echo ""
          echo "dyld:"
          ls -la ios_extracted/dyld_cache/ 2>/dev/null || echo "无"

      - name: Upload results
        uses: actions/upload-artifact@v4
        with:
          name: extracted_files
          path: ios_extracted/
          retention-days: 7
